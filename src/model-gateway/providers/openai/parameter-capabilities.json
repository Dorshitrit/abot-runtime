{
  "provider": "openai",
  "parameters": {
    "temperature": { "path": ["temperature"], "min": 0, "max": 2, "compatibility": { "key": "reasoning_effort", "values": ["none"], "allowMissing": true } },
    "top_p": { "path": ["top_p"], "min": 0, "max": 1, "compatibility": { "key": "reasoning_effort", "values": ["none"], "allowMissing": true } },
    "max_output_tokens": { "path": ["max_output_tokens"], "min": 1 },
    "reasoning_effort": { "path": ["reasoning", "effort"] }
  }
}
