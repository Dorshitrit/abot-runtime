{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "system-probe",
  "version": "1.0.0",
  "description": "Report host CPU, memory, uptime and disk-volume capacity.",
  "extensions": {
    "ai.abot.compatibility": {
      "version": 1,
      "runtimePlatforms": ["linux", "darwin", "win32"]
    },
    "ai.abot.runtime": {
      "version": 1,
      "entrypoint": "./src/index.cjs",
      "catalogGroups": ["read", "system"],
      "capabilities": {
        "system_probe": {
          "description": "Measure host resources: CPU count and load, RAM usage, uptime, and filesystem capacity in bytes. An optional existing path selects the filesystem volume for capacity measurement.",
          "routingCapability": "filesystem_inspection",
          "developmentRoles": ["inspect", "verify"],
          "eventPresentation": {
            "metadata": {
              "path": {
                "param": "path",
                "kind": "string"
              }
            },
            "resultMetadata": {
              "path": { "path": "data.diskPath", "kind": "preview" }
            }
          },
          "skills": [],
          "controlsRefinement": "mechanical_when_complete",
          "operations": {
            "inspect_system_state": {
              "summary": "Measure host CPU count and load, RAM usage, uptime, and default-filesystem capacity in bytes.",
              "input": {
                "type": "object",
                "additionalProperties": false,
                "properties": {},
                "required": []
              },
              "effect": "read_only",
              "approval": "request_policy"
            },
            "inspect_disk_state_for_path": {
              "summary": "Measure filesystem capacity (total, used and free bytes), plus host CPU, RAM, load and uptime. Requires an existing path selecting the filesystem volume.",
              "input": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required": ["path"]
              },
              "effect": "read_only",
              "approval": "request_policy"
            }
          }
        }
      }
    }
  }
}
