{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "code-outline",
  "version": "0.1.1",
  "description": "Extract a bounded structural outline from one source file.",
  "extensions": {
    "ai.abot.runtime": {
      "version": 1,
      "entrypoint": "./src/index.cjs",
      "catalogGroups": ["read"],
      "settings": {
        "defaults": {
          "defaultMaxSymbols": 160
        }
      },
      "capabilities": {
        "inspect_code_outline": {
          "description": "Extract a bounded outline of symbols, selectors, elements, and imports from one source file beneath the configured agent work directory or configured workspace sources, without returning the full file.",
          "routingCapability": "semantic_lookup",
          "eventPresentation": {
            "metadata": {
              "displayTarget": { "param": "path", "kind": "string" },
              "maxSymbols": { "param": "maxSymbols", "kind": "number" }
            },
            "resultMetadata": {
              "outputPreview": { "path": "output", "kind": "preview" },
              "lineCount": { "path": "data.lineCount", "kind": "number" },
              "returnedItemCount": { "path": "data.truncation.returnedSymbols", "kind": "number" },
              "totalItemCount": { "path": "data.truncation.totalSymbols", "kind": "number" },
              "sourceTruncated": { "path": "data.truncation.symbolsTruncated", "kind": "boolean" },
              "importsTruncated": { "path": "data.truncation.importsTruncated", "kind": "boolean" },
              "outputTruncated": { "path": "data.truncation.output.truncated", "kind": "boolean" }
            }
          },
          "runtimePathBindings": [
            {
              "operationId": "inspect_code_outline",
              "param": "path",
              "base": "worker_working_directory"
            }
          ],
          "skills": ["code_outline_skill"],
          "operations": {
            "inspect_code_outline": {
              "summary": "Inspect symbols and dependencies in one bounded source file.",
              "input": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "maxSymbols": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 160
                  }
                },
                "required": ["path"]
              },
              "effect": "read_only",
              "approval": "request_policy"
            }
          }
        }
      }
    }
  }
}
