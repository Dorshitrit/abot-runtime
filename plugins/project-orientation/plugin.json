{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "project-orientation",
  "version": "0.3.1",
  "description": "Inspect project directories and manifest metadata.",
  "extensions": {
    "ai.abot.compatibility": { "version": 1, "runtimePlatforms": ["linux", "darwin", "win32"] },
    "ai.abot.runtime": {
      "version": 1,
      "entrypoint": "./src/index.cjs",
      "catalogGroups": ["read"],
      "settings": {
        "defaults": {
          "defaultDepth": 0,
          "maxEntries": 40
        }
      },
      "capabilities": {
        "inspect_project": {
          "description": "Inspect a project overview in bounded pages. Start with depth 0, then inspect a selected subdirectory or continue with nextCursor. Path `.` and relative paths resolve inside the configured agent work directory; `workspace/...` targets configured workspace sources.",
          "routingCapability": "semantic_lookup",
          "eventPresentation": {
            "metadata": {
              "displayTarget": { "param": "path", "kind": "string" },
              "depth": { "param": "depth", "kind": "number" },
              "maxEntries": { "param": "maxEntries", "kind": "number" }
            },
            "resultMetadata": {
              "outputPreview": { "path": "output", "kind": "preview" },
              "depth": { "path": "data.depth", "kind": "number" },
              "maxEntries": { "path": "data.maxEntries", "kind": "number" },
              "sourceTruncated": { "path": "data.truncation.tree", "kind": "boolean" },
              "outputTruncated": { "path": "data.truncation.output.truncated", "kind": "boolean" },
              "hasMore": { "path": "data.pagination.hasMore", "kind": "boolean" }
            }
          },
          "runtimePathBindings": [
            {
              "operationId": "inspect_project",
              "param": "path",
              "base": "worker_working_directory",
              "default": "."
            }
          ],
          "skills": ["project_orientation_skill"],
          "operations": {
            "inspect_project": {
              "summary": "Inspect a flat project overview by default; select a subdirectory for detail. Each page has at most 40 entries and a 4000-character total result, including explicit depth or entry requests. Use the returned cursor with the same path and depth to continue. A scan beyond 1000 visited entries requires a narrower path or depth.",
              "input": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 1024
                  },
                  "depth": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 6
                  },
                  "maxEntries": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 250
                  },
                  "cursor": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
                },
                "required": []
              },
              "effect": "read_only",
              "approval": "request_policy"
            }
          }
        }
      }
    }
  }
}
